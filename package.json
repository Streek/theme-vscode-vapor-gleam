{
  "name": "vapor-gleam",
  "displayName": "Vapor Gleam",
  "description": "A vibrant Gleam-inspired color theme with vapor wave and neon aesthetics",
  "version": "1.0.1",
  "publisher": "streek",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "gleam",
    "vapor",
    "vaporwave",
    "neon",
    "dark"
  ],
  "scripts": {
    "check": "npm run check:metadata && npm run package && npm run check:vsix",
    "check:metadata": "node scripts/check.js",
    "check:vsix": "node scripts/check-vsix.js",
    "package": "vsce package --no-dependencies",
    "publish:only": "node scripts/publish.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.26.1"
  },
  "contributes": {
    "themes": [
      {
        "label": "Vapor Gleam",
        "uiTheme": "vs-dark",
        "path": "./themes/Vapor Gleam-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streek/theme-vscode-vapor-gleam.git"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "homepage": "https://github.com/streek/theme-vscode-vapor-gleam",
  "bugs": {
    "url": "https://github.com/streek/theme-vscode-vapor-gleam/issues"
  },
  "license": "MIT"
}
